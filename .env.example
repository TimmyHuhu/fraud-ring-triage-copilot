# Fraud Ring Triage Copilot - environment variables
#
# Copy this file to .env and fill in your own values.
# The .env file is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# All variables below are OPTIONAL. The dashboard runs fully offline on the
# included sample dataset without any of them. They are placeholders for the
# planned Cognee-backed shared memory integration described in the README.

# Cognee shared-memory layer (optional, future integration)
COGNEE_API_KEY=your-cognee-api-key-here
COGNEE_API_URL=https://api.cognee.ai
